{
  "name": "killions-record-shelf",
  "productName": "Killion's Record Shelf",
  "version": "1.2.0",
  "description": "A large-print record collection app: covers, sleeve info and values, made easy.",
  "main": "main.js",
  "author": "James Sullivan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/lookup.test.js && node test/csv.test.js",
    "dist": "electron-builder --win nsis --x64 --ia32",
    "dist:64": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.killionsrecordshelf.app",
    "productName": "Killion's Record Shelf",
    "copyright": "Copyright © 2026 James Sullivan",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Killion's Record Shelf",
      "artifactName": "Killions-Record-Shelf-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
